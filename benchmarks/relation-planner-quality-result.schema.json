{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/doppel-memory/doppel/schemas/relation-planner-quality-result.schema.json",
  "title": "Doppel relation planner quality result",
  "type": "object",
  "required": [
    "runner",
    "doppel_version",
    "generated_at",
    "dataset",
    "planner",
    "environment",
    "metrics",
    "by_partition",
    "by_category",
    "usage",
    "budget",
    "cache",
    "cases"
  ],
  "properties": {
    "runner": {"const": "doppel.relation-planner-quality.v1"},
    "scoring_version": {"const": "2"},
    "output_diagnostics": {
      "type": "object",
      "required": ["truncated_count", "invalid_draft_count", "validation_code_counts", "explanation_chars"],
      "properties": {
        "truncated_count": {"type": "integer", "minimum": 0},
        "invalid_draft_count": {"type": "integer", "minimum": 0},
        "validation_code_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "explanation_chars": {
          "type": "object",
          "required": ["valid_case_count", "over_80_count", "p50", "p95", "max"],
          "properties": {
            "valid_case_count": {"type": "integer", "minimum": 0},
            "over_80_count": {"type": "integer", "minimum": 0},
            "p50": {"type": ["number", "null"], "minimum": 0},
            "p95": {"type": ["number", "null"], "minimum": 0},
            "max": {"type": ["integer", "null"], "minimum": 0}
          }
        }
      }
    },
    "relation_catalog": {
      "type": "object",
      "required": ["mode", "definition_count", "fingerprint", "definitions"],
      "properties": {
        "mode": {"enum": ["labels_only", "definitions"]},
        "definition_count": {"type": "integer", "minimum": 0},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "source_description", "target_description", "constraints"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
              "description": {"type": "string", "minLength": 1},
              "source_description": {"type": "string", "minLength": 1},
              "target_description": {"type": "string", "minLength": 1},
              "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["complete", "stopped_early", "stop_reason", "stopped_at_query_id", "evaluated_case_count", "not_run_case_count", "quality_measurement"],
      "properties": {
        "complete": {"type": "boolean"},
        "stopped_early": {"type": "boolean"},
        "stop_reason": {"type": "string"},
        "stopped_at_query_id": {"type": "string"},
        "evaluated_case_count": {"type": "integer", "minimum": 0},
        "not_run_case_count": {"type": "integer", "minimum": 0},
        "quality_measurement": {"enum": ["available", "unavailable"]}
      }
    },
    "semantic_review": {
      "type": "object",
      "required": ["version", "status", "publication_ready", "sha256", "dataset_fingerprint", "legacy_scores_unchanged", "relation_assessment_counts", "temporal_assessment_counts", "cases"],
      "properties": {
        "status": {"const": "posthoc_diagnostic"},
        "publication_ready": {"const": false},
        "legacy_scores_unchanged": {"const": true},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "doppel_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "dataset": {
      "type": "object",
      "required": [
        "name",
        "version",
        "fingerprint",
        "query_count",
        "frozen",
        "publication_ready",
        "relation_type_count"
      ],
      "properties": {
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "query_count": {"type": "integer", "minimum": 1},
        "frozen": {"type": "boolean"},
        "publication_ready": {"type": "boolean"},
        "relation_type_count": {"type": "integer", "minimum": 0}
      }
    },
    "planner": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "environment": {"type": "object"},
    "metrics": {
      "type": "object",
      "required": [
        "case_count",
        "valid_case_count",
        "provider_error_count",
        "structural_failure_count",
        "exact_structure_accuracy",
        "typed_structure_accuracy",
        "intent_accuracy",
        "intent_semantics_accuracy",
        "as_of_presence_accuracy",
        "as_of_date_accuracy",
        "temporal_plan_accuracy",
        "subject_binding_accuracy",
        "entity_recall",
        "relation_recall",
        "relation_type_exact_accuracy",
        "relation_type_recall",
        "relation_type_precision",
        "relation_type_failure_count",
        "unexpected_relation_type_count",
        "relation_type_ontology_violation_count",
        "unexpected_entity_count",
        "unexpected_relation_count",
        "unexpected_hard_filter_count",
        "latency_ms"
      ],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1},
        "valid_case_count": {"type": "integer", "minimum": 0},
        "provider_error_count": {"type": "integer", "minimum": 0},
        "not_run_case_count": {"type": "integer", "minimum": 0},
        "structural_failure_count": {"type": "integer", "minimum": 0},
        "exact_structure_accuracy": {"$ref": "#/$defs/ratio"},
        "typed_structure_accuracy": {"$ref": "#/$defs/ratio"},
        "intent_accuracy": {"$ref": "#/$defs/ratio"},
        "intent_semantics_accuracy": {"$ref": "#/$defs/ratio"},
        "as_of_presence_accuracy": {"$ref": "#/$defs/ratio"},
        "as_of_date_accuracy": {"$ref": "#/$defs/ratio"},
        "temporal_plan_accuracy": {"$ref": "#/$defs/ratio"},
        "subject_binding_accuracy": {"$ref": "#/$defs/ratio"},
        "entity_recall": {"$ref": "#/$defs/ratio"},
        "relation_recall": {"$ref": "#/$defs/ratio"},
        "relation_type_exact_accuracy": {"$ref": "#/$defs/ratio"},
        "relation_type_recall": {"$ref": "#/$defs/ratio"},
        "relation_type_precision": {"$ref": "#/$defs/ratio"},
        "relation_type_failure_count": {"type": "integer", "minimum": 0},
        "unexpected_relation_type_count": {"type": "integer", "minimum": 0},
        "relation_type_ontology_violation_count": {"type": "integer", "minimum": 0},
        "unexpected_entity_count": {"type": "integer", "minimum": 0},
        "unexpected_relation_count": {"type": "integer", "minimum": 0},
        "unexpected_hard_filter_count": {"type": "integer", "minimum": 0},
        "latency_ms": {
          "type": "object",
          "required": ["p50", "p95", "max"]
        }
      }
    },
    "by_partition": {"type": "object"},
    "by_category": {"type": "object"},
    "usage": {"type": "object"},
    "budget": {
      "type": "object",
      "required": ["max_calls", "calls"]
    },
    "cache": {
      "type": "object",
      "required": ["enabled", "hits", "misses"]
    },
    "replay": {
      "type": "object",
      "required": [
        "source_path",
        "source_sha256",
        "source_dataset_fingerprint",
        "provider_calls"
      ],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_dataset_fingerprint": {"type": "string"},
        "provider_calls": {"const": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "query_id",
          "partition",
          "category",
          "query",
          "error",
          "error_code",
          "latency_ms",
          "structure_ok",
          "intent_ok",
          "intent_semantics_ok",
          "as_of_presence_ok",
          "as_of_date_ok",
          "temporal_plan_ok",
          "subject_binding_ok",
          "expected_entity_count",
          "matched_entity_count",
          "unexpected_entity_count",
          "expected_relation_count",
          "matched_relation_count",
          "unexpected_relation_count",
          "expected_relation_type_count",
          "actual_relation_type_count",
          "matched_relation_type_count",
          "unexpected_relation_type_count",
          "relation_type_ontology_violation_count",
          "relation_type_ok",
          "typed_structure_ok",
          "unexpected_hard_filter_count",
          "hard_filter_ok",
          "actual"
        ],
        "properties": {
          "status": {"enum": ["valid", "error", "not_run"]},
          "request_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "error_origin": {"enum": ["", "current_run", "source_report", "not_run"]},
          "http_status": {"type": ["integer", "null"]},
          "validation_diagnostics_available": {"type": "boolean"},
          "validation_errors": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["location", "type"],
              "properties": {
                "location": {"type": "array", "items": {"type": ["integer", "string"]}},
                "type": {"type": "string"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  }
}
