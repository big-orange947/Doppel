{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/big-orange947/Doppel/benchmarks/consolidation-result.schema.json",
  "title": "Doppel consolidation quality result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_schema_version",
    "doppel_version",
    "generated_at",
    "dataset",
    "environment",
    "metrics",
    "cases",
    "correctness"
  ],
  "properties": {
    "result_schema_version": { "const": 2 },
    "doppel_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "language",
        "fingerprint",
        "case_count",
        "memory_count",
        "expected_action_count"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "language": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "case_count": { "type": "integer", "minimum": 1 },
        "memory_count": { "type": "integer", "minimum": 2 },
        "expected_action_count": { "type": "integer", "minimum": 0 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "implementation", "platform"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "implementation": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "false_action_count",
        "missing_action_count",
        "wrong_canonical_count",
        "source_lifecycle_error_count",
        "scope_leakage_count",
        "latency_ms"
      ],
      "properties": {
        "false_action_count": { "type": "integer", "minimum": 0 },
        "missing_action_count": { "type": "integer", "minimum": 0 },
        "wrong_canonical_count": { "type": "integer", "minimum": 0 },
        "source_lifecycle_error_count": { "type": "integer", "minimum": 0 },
        "scope_leakage_count": { "type": "integer", "minimum": 0 },
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "max"],
          "properties": {
            "total": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "input_memory_count",
          "expected_action_count",
          "actual_action_count",
          "false_action_count",
          "missing_action_count",
          "wrong_canonical_count",
          "source_lifecycle_error_count",
          "scope_leakage_count",
          "conflict_marker_count",
          "active_memory_count",
          "active_contents",
          "actions",
          "latency_ms",
          "errors"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "input_memory_count": { "type": "integer", "minimum": 2 },
          "expected_action_count": { "type": "integer", "minimum": 0 },
          "actual_action_count": { "type": "integer", "minimum": 0 },
          "false_action_count": { "type": "integer", "minimum": 0 },
          "missing_action_count": { "type": "integer", "minimum": 0 },
          "wrong_canonical_count": { "type": "integer", "minimum": 0 },
          "source_lifecycle_error_count": { "type": "integer", "minimum": 0 },
          "scope_leakage_count": { "type": "integer", "minimum": 0 },
          "conflict_marker_count": { "type": "integer", "minimum": 0 },
          "active_memory_count": { "type": "integer", "minimum": 0 },
          "active_contents": {
            "type": "array",
            "items": { "type": "string" }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation",
                "source_memory_ids",
                "canonical_source_memory_id",
                "decision_id"
              ],
              "properties": {
                "operation": { "enum": ["merge", "correct", "conflict"] },
                "source_memory_ids": {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "canonical_source_memory_id": {
                  "type": "string"
                },
                "decision_id": {
                  "type": "string",
                  "pattern": "^cds_[0-9a-f]{64}$"
                }
              }
            }
          },
          "latency_ms": { "type": "number", "minimum": 0 },
          "errors": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "scope_leakage_count", "errors"],
      "properties": {
        "passed": { "type": "boolean" },
        "scope_leakage_count": { "type": "integer", "minimum": 0 },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
