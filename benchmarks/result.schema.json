{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/big-orange947/Doppel/benchmarks/result.schema.json",
  "title": "Doppel Store Benchmark Result",
  "type": "object",
  "required": [
    "result_schema_version",
    "doppel_version",
    "generated_at",
    "dataset",
    "environment",
    "backend",
    "metrics",
    "correctness"
  ],
  "properties": {
    "result_schema_version": { "const": 1 },
    "doppel_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "dataset": {
      "type": "object",
      "required": [
        "dataset_version",
        "generator",
        "fingerprint",
        "seed",
        "scope_count",
        "records_per_scope",
        "record_count",
        "query_samples",
        "page_size"
      ],
      "properties": {
        "dataset_version": { "type": "integer", "minimum": 1 },
        "generator": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "scope_count": { "type": "integer", "minimum": 2 },
        "records_per_scope": { "type": "integer", "minimum": 1 },
        "record_count": { "type": "integer", "minimum": 1 },
        "query_samples": { "type": "integer", "minimum": 1 },
        "page_size": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["python", "implementation", "platform"],
      "properties": {
        "python": { "type": "string" },
        "implementation": { "type": "string" },
        "platform": { "type": "string" }
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "required": ["name", "capabilities"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "write",
        "duplicate_write",
        "exact_scope_search",
        "filtered_search",
        "scan"
      ],
      "properties": {
        "write": { "$ref": "#/$defs/metric" },
        "duplicate_write": { "$ref": "#/$defs/metric" },
        "exact_scope_search": { "$ref": "#/$defs/metric" },
        "filtered_search": { "$ref": "#/$defs/metric" },
        "scan": { "$ref": "#/$defs/metric" }
      },
      "additionalProperties": false
    },
    "correctness": {
      "type": "object",
      "required": [
        "passed",
        "scope_leakage_count",
        "forbidden_memory_hits",
        "missing_expected_memories",
        "duplicate_write_failures",
        "scan_duplicate_records",
        "scan_count_mismatch",
        "errors"
      ],
      "properties": {
        "passed": { "type": "boolean" },
        "scope_leakage_count": { "type": "integer", "minimum": 0 },
        "forbidden_memory_hits": { "type": "integer", "minimum": 0 },
        "missing_expected_memories": { "type": "integer", "minimum": 0 },
        "duplicate_write_failures": { "type": "integer", "minimum": 0 },
        "scan_duplicate_records": { "type": "integer", "minimum": 0 },
        "scan_count_mismatch": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": [
        "operations",
        "total_seconds",
        "operations_per_second",
        "latency_ms"
      ],
      "properties": {
        "operations": { "type": "integer", "minimum": 0 },
        "total_seconds": { "type": "number", "minimum": 0 },
        "operations_per_second": { "type": "number", "minimum": 0 },
        "latency_ms": {
          "type": "object",
          "required": ["min", "p50", "p95", "p99", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "p50": { "type": "number", "minimum": 0 },
            "p95": { "type": "number", "minimum": 0 },
            "p99": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "created": { "type": "number", "minimum": 0 },
        "records_scanned": { "type": "number", "minimum": 0 },
        "records_per_second": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
