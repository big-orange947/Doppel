{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/big-orange947/Doppel/benchmarks/vector-result.schema.json",
  "title": "Doppel pgvector quality result",
  "type": "object",
  "required": [
    "result_schema_version",
    "doppel_version",
    "generated_at",
    "dataset",
    "index",
    "cases",
    "correctness"
  ],
  "properties": {
    "result_schema_version": { "const": 1 },
    "doppel_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "dataset": { "type": "object" },
    "index": { "type": "object" },
    "cases": { "type": "array", "minItems": 1 },
    "correctness": {
      "type": "object",
      "required": [
        "passed",
        "semantic_top1_misses",
        "hybrid_top1_misses",
        "scope_leakage_count",
        "forbidden_memory_hits",
        "errors"
      ],
      "properties": {
        "passed": { "type": "boolean" },
        "semantic_top1_misses": { "type": "integer", "minimum": 0 },
        "hybrid_top1_misses": { "type": "integer", "minimum": 0 },
        "scope_leakage_count": { "type": "integer", "minimum": 0 },
        "forbidden_memory_hits": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
