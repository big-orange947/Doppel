{
  "dataset_version": 2,
  "name": "doppel.consolidation-quality.zh.v2",
  "language": "zh-CN",
  "scopes": [
    {
      "name": "owner-user",
      "user_id": "quality-owner"
    },
    {
      "name": "other-user",
      "user_id": "quality-other"
    }
  ],
  "cases": [
    {
      "name": "repeated-preference-merge",
      "category": "duplicate",
      "description": "Repeated extraction of one preference becomes one canonical memory with both source records preserved as superseded.",
      "scope": "owner-user",
      "memories": [
        {
          "memory_id": "coffee-001",
          "scope": "owner-user",
          "content": "用户不喝咖啡。",
          "at": "2026-01-01T09:00:00+08:00",
          "memory_type": "preference",
          "topic_key": "beverage.coffee",
          "evidence_ids": ["coffee-message-001"]
        },
        {
          "memory_id": "coffee-002",
          "scope": "owner-user",
          "content": "用户不喝咖啡",
          "at": "2026-02-01T09:00:00+08:00",
          "memory_type": "preference",
          "topic_key": "beverage.coffee",
          "evidence_ids": ["coffee-message-002"]
        }
      ],
      "expected_actions": [
        {
          "operation": "merge",
          "source_memory_ids": ["coffee-001", "coffee-002"],
          "canonical_source_memory_id": "coffee-002"
        }
      ]
    },
    {
      "name": "favorite-color-correction",
      "category": "correction",
      "description": "A newer current value in the same explicit mutable slot replaces the older value.",
      "scope": "owner-user",
      "memories": [
        {
          "memory_id": "color-blue",
          "scope": "owner-user",
          "content": "用户最喜欢蓝色。",
          "at": "2025-01-01T09:00:00+08:00",
          "memory_type": "preference",
          "topic_key": "preference.favorite-color",
          "evidence_ids": ["color-message-blue"]
        },
        {
          "memory_id": "color-green",
          "scope": "owner-user",
          "content": "用户现在最喜欢绿色。",
          "at": "2026-01-01T09:00:00+08:00",
          "memory_type": "preference",
          "topic_key": "preference.favorite-color",
          "revision_kind": "correction",
          "evidence_ids": ["color-message-green"]
        }
      ],
      "expected_actions": [
        {
          "operation": "correct",
          "source_memory_ids": ["color-blue", "color-green"],
          "canonical_source_memory_id": "color-green"
        }
      ]
    },
    {
      "name": "unrelated-preferences-remain-separate",
      "category": "false_merge_guard",
      "description": "Different claims without a stable shared topic are not interpreted as a correction.",
