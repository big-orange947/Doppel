{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/doppel-memory/doppel/schemas/personal-retrieval-ablation-result.schema.json",
  "title": "Doppel personal retrieval ablation result",
  "type": "object",
  "required": [
    "runner", "dataset", "environment", "runtime", "planner_modes",
    "profiles", "diagnostics", "comparisons", "hard_gates",
    "hard_gates_by_profile", "cases",
    "deferred_queries", "graph_final_hit_attribution", "metamorphic",
    "reproducibility", "elapsed_seconds", "doppel_version", "generated_at",
    "suite_fingerprint"
  ],
  "properties": {
    "runner": {"enum": ["doppel.personal-retrieval-ablation.v1", "doppel.personal-relation-ablation.v1"]},
    "dataset": {
      "type": "object",
      "required": ["name", "version", "status", "frozen", "publication_ready", "fingerprint", "memory_count", "query_count", "partition_counts"],
      "properties": {
        "frozen": {"type": "boolean"},
        "publication_ready": {"type": "boolean"},
        "memory_count": {"type": "integer", "minimum": 1},
        "query_count": {"type": "integer", "minimum": 1},
        "partition_counts": {
          "type": "object",
          "required": ["dev", "heldout", "adversarial", "deferred_cross_subject"]
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["store", "vector", "graph"],
      "properties": {
        "store": {"$ref": "#/$defs/source"},
        "vector": {"$ref": "#/$defs/source"},
        "graph": {"$ref": "#/$defs/source"},
        "relation_reranker": {"$ref": "#/$defs/source"}
      }
    },
    "planner_modes": {"type": "array", "items": {"enum": ["oracle", "deterministic", "report"]}},
    "profiles": {
      "type": "object",
      "propertyNames": {"enum": ["oracle", "deterministic", "report"]},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"enum": ["lexical", "lexical_vector", "lexical_graph", "lexical_vector_graph", "lexical_relation", "lexical_vector_relation", "lexical_relation_reranked", "lexical_vector_relation_reranked"]},
        "additionalProperties": {"$ref": "#/$defs/profile"}
      }
    },
    "diagnostics": {
      "type": "object",
      "propertyNames": {"enum": ["vector_direct", "graph_direct", "composite_direct", "composite_graph_only_degradation", "composite_vector_only_degradation"]}
    },
    "comparisons": {"type": "object"},
    "hard_gates": {
      "type": "object",
      "required": ["planner_failures", "retrieval_failures", "security_failures", "fixture_validation_failures"],
      "properties": {
        "planner_failures": {"type": "array", "items": {"type": "string"}},
        "retrieval_failures": {"type": "array", "items": {"type": "string"}},
        "security_failures": {"type": "array", "items": {"type": "string"}},
        "fixture_validation_failures": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hard_gates_by_profile": {"type": "object"},
    "graph_final_hit_attribution": {"type": "object"},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "metamorphic": {"type": "object"},
    "threshold_sweep": {"type": "object"},
    "relation_reranker_threshold_sweep": {"type": "object"},
    "reproducibility": {
      "type": "object",
      "required": ["output_path", "command", "commit_hash", "planner_modes", "requested_profiles", "gate_profiles", "executed_profiles", "unavailable_profiles", "dataset_fingerprint", "canonical_payload_sha256", "file_sha256_sidecar"]
    },
    "elapsed_seconds": {"type": "number"},
    "doppel_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "suite_fingerprint": {"type": "string"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "kind": {"type": "string"},
        "available": {"type": "boolean"},
        "reason": {"type": "string"},
        "metadata": {"type": "object"}
      }
    },
    "profile": {
      "type": "object",
      "required": ["query_count", "error_count"],
      "allOf": [
        {
          "if": {
            "required": ["unavailable"],
            "properties": {"unavailable": {"const": true}}
          },
          "then": {"required": ["unavailable", "reason"]},
          "else": {
            "required": ["recall_at_1", "recall_at_5", "mrr", "required_evidence_recall", "forbidden_hit_count", "scope_leakage_count", "temporal_violation_count", "provenance_failure_count", "abstention_accuracy", "ambiguity_accuracy", "count_accuracy", "latency_ms"]
          }
        }
      ],
      "properties": {
        "query_count": {"type": "integer"},
        "error_count": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "boolean"},
        "reason": {"type": "string"},
        "recall_at_1": {"type": "number", "minimum": 0, "maximum": 1},
        "recall_at_5": {"type": "number", "minimum": 0, "maximum": 1},
        "mrr": {"type": "number", "minimum": 0, "maximum": 1},
        "required_evidence_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "forbidden_hit_count": {"type": "integer", "minimum": 0},
        "scope_leakage_count": {"type": "integer", "minimum": 0},
        "temporal_violation_count": {"type": "integer", "minimum": 0},
        "provenance_failure_count": {"type": "integer", "minimum": 0},
        "abstention_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "ambiguity_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "count_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "latency_ms": {"type": "object", "required": ["p50", "p95", "max"]},
        "contribution": {
          "type": "object",
          "required": ["vector", "graph", "both", "relation", "relation_reranker"]
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["query_id", "profile", "mode", "partition", "category", "error", "latency_ms", "hits", "missing", "forbidden", "scope_leakage", "temporal_violations", "provenance_failures", "abstention_ok", "ambiguity_ok", "count_ok", "hit_top1_ok", "recall_at_1", "recall_at_5", "mrr", "evidence_recall", "intent_ok", "required_evidence", "expected_abstain", "as_of_recognized", "planner_failures", "retrieval_failures", "security_failures"],
      "properties": {
        "error": {"type": "string"},
        "scope_leakage": {"type": "integer", "minimum": 0},
        "forbidden": {"type": "array", "items": {"type": "string"}},
        "hits": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
