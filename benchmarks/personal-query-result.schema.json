{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/big-orange947/Doppel/benchmarks/personal-query-result.schema.json",
  "title": "Doppel personal-memory query quality result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_schema_version",
    "doppel_version",
    "generated_at",
    "dataset",
    "environment",
    "retrieval",
    "metrics",
    "cases",
    "correctness"
  ],
  "properties": {
    "result_schema_version": { "const": 2 },
    "doppel_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "language",
        "fingerprint",
        "memory_count",
        "query_count"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "language": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "memory_count": { "type": "integer", "minimum": 1 },
        "query_count": { "type": "integer", "minimum": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "implementation", "platform"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "implementation": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "semantic_index", "planner", "planner_version"],
      "properties": {
        "mode": { "const": "lexical-domain-neutral" },
        "semantic_index": { "const": false },
        "planner": { "type": "string", "minLength": 1 },
        "planner_version": { "type": "string", "minLength": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_hit_count",
        "forbidden_hit_count",
        "intent_error_count",
        "count_error_count",
        "ambiguity_error_count",
        "scope_leakage_count",
        "latency_ms"
      ],
      "properties": {
        "missing_hit_count": { "type": "integer", "minimum": 0 },
        "forbidden_hit_count": { "type": "integer", "minimum": 0 },
        "intent_error_count": { "type": "integer", "minimum": 0 },
        "count_error_count": { "type": "integer", "minimum": 0 },
        "ambiguity_error_count": { "type": "integer", "minimum": 0 },
        "scope_leakage_count": { "type": "integer", "minimum": 0 },
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "max"],
          "properties": {
            "total": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "query",
          "expected_intent",
          "actual_intent",
          "required_hit_ids",
          "actual_hit_ids",
          "missing_hit_count",
          "forbidden_hit_count",
          "intent_error_count",
          "count_error_count",
          "ambiguity_error_count",
          "scope_leakage_count",
          "count_status",
          "count_value",
          "ambiguous",
          "warnings",
          "latency_ms",
          "errors"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "query": { "type": "string", "minLength": 1 },
          "expected_intent": {
            "enum": ["lookup", "current", "history", "planned", "list", "count", "as_of"]
          },
          "actual_intent": {
            "enum": ["lookup", "current", "history", "planned", "list", "count", "as_of"]
          },
          "required_hit_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "actual_hit_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "missing_hit_count": { "type": "integer", "minimum": 0 },
          "forbidden_hit_count": { "type": "integer", "minimum": 0 },
          "intent_error_count": { "type": "integer", "minimum": 0 },
          "count_error_count": { "type": "integer", "minimum": 0 },
          "ambiguity_error_count": { "type": "integer", "minimum": 0 },
          "scope_leakage_count": { "type": "integer", "minimum": 0 },
          "count_status": {
            "enum": ["not_requested", "exact", "indeterminate"]
          },
          "count_value": {
            "oneOf": [
              { "type": "integer", "minimum": 0 },
              { "type": "null" }
            ]
          },
          "ambiguous": { "type": "boolean" },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "latency_ms": { "type": "number", "minimum": 0 },
          "errors": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "scope_leakage_count", "errors"],
      "properties": {
        "passed": { "type": "boolean" },
        "scope_leakage_count": { "type": "integer", "minimum": 0 },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
